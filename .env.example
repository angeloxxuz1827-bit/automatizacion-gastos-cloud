# ==========================
# Telegram Bot Configuration
# ==========================
# La constante Python es TELEGRAM_TOKEN; la variable de entorno es TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_API_URL=https://api.telegram.org

# ==========================
# Groq API Configuration
# ==========================
GROQ_API_KEY=your_groq_api_key
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ==========================
# Supabase (Lambda store)
# ==========================
# `SUPABASE_SECRET_KEY` es la secret key nueva del dashboard. Es sensible:
# no la subas al repositorio ni la pegues en el chat.
# `SUPABASE_PUBLISHABLE_KEY` y `SUPABASE_JWKS_URL` no las usa el store; se dejan
# para clientes o herramientas locales.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Nombre legacy aceptado por el código si aún no migras la variable:
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ==========================
# AWS / MySQL legado (opcional en local)
# ==========================
# BUCKET_NAME=your-expense-tracker-bucket
# DB_HOST=your-rds-endpoint.amazonaws.com
# DB_PORT=3306
# DB_NAME=expenses_db
# DB_USER=admin
# DB_PASSWORD=your_secure_password
